# Unity 6 .gitignore
# Combined Unity, JetBrains, and VS Code patterns
# Get latest from https://github.com/github/gitignore

# ===================================
# Unity Generated
# ===================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity 6 specific
.utmp/
*.log

# Asset imports - Blender backup files
*.blend1
*.blend1.meta

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# ===================================
# Visual Studio / Rider
# ===================================
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Jetbrains Rider personal settings
*.DotSettings.user

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ===================================
# Unity Crashes & Reports
# ===================================
sysinfo.txt
mono_crash.*
*.stackdump

# ===================================
# Build Outputs
# ===================================
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# ===================================
# Addressables
# ===================================
/[Ss]erverData/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ===================================
# Visual Scripting (Unity 6)
# ===================================
/[Aa]ssets/Unity.VisualScripting.Generated/

# ===================================
# Test Runner
# ===================================
[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ===================================
# JetBrains IDEs
# ===================================
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/aws.xml
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/mongoSettings.xml
.idea/sonarlint/
.idea/sonarlint.xml
.idea/httpRequests
.idea/caches/build_file_checksums.ser
.idea/.cache/.Apifox_Helper
.idea/ApifoxUploaderProjectSetting.xml
.idea/replstate.xml

# File-based project format
*.iws

# IntelliJ output
out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# HTTP Client
http-client.private.env.json

# ===================================
# VS Code
# ===================================
.vscode/
.history/
*.code-workspace

*.vsix

# ===================================
# Other
# ===================================
.gradle/
cmake-build-*/
ExportedObj/
.consulo/
